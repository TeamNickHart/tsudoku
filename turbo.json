{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "benchmark": {
      "dependsOn": ["build"],
      "outputs": ["benchmark-results/**"]
    },
    "docs:build": {
      "dependsOn": ["^build"]
    }
  }
}
