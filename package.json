{
  "name": "tsudoku",
  "private": true,
  "description": "A TypeScript-first Sudoku engine. Human techniques, machine precision.",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "turbo test",
    "benchmark": "turbo benchmark",
    "benchmark:quick": "tsx benchmarks/runner.ts --phases=1",
    "benchmark:full": "tsx benchmarks/runner.ts",
    "corpus:generate": "bash tools/se-reference/generate-corpus.sh",
    "puzzle:intake": "bash tools/se-reference/intake.sh",
    "puzzle:build-corpus": "bash tools/se-reference/build-corpus.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
